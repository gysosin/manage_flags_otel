# Example Kubeconfig File
# Copy this file to kubeconfig.yaml and update with your cluster details
#
# To get your kubeconfig from various providers:
#
# AWS EKS:
#   aws eks update-kubeconfig --name <cluster-name> --region <region>
#
# GCP GKE:
#   gcloud container clusters get-credentials <cluster-name> --zone <zone>
#
# Azure AKS:
#   az aks get-credentials --resource-group <rg> --name <cluster-name>
#
# Local Kind/Minikube:
#   kind export kubeconfig --name <cluster-name>
#   or simply: cat ~/.kube/config > kubeconfig.yaml

apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: <BASE64_ENCODED_CA_CERT>
    server: https://<KUBERNETES_API_SERVER>:6443
  name: my-cluster
contexts:
- context:
    cluster: my-cluster
    user: my-user
    namespace: otel-demo
  name: my-context
current-context: my-context
users:
- name: my-user
  user:
    # Option 1: Token authentication
    token: <SERVICE_ACCOUNT_TOKEN>
    
    # Option 2: Client certificate authentication
    # client-certificate-data: <BASE64_ENCODED_CLIENT_CERT>
    # client-key-data: <BASE64_ENCODED_CLIENT_KEY>
